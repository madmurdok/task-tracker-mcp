{
  "name": "task-tracker-mcp",
  "version": "0.5.0",
  "description": "Local MCP server for agent-driven task planning and cross-session handoff",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "task-tracker-status": "dist/cli/status.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "status": "node dist/cli/status.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
